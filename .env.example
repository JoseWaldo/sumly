# ── Compartidas (todos los ambientes) ────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sumly_db

# Usuarios de BD con permisos separados por seguridad
POSTGRES_APP_USER=sumly_app
POSTGRES_APP_PASSWORD=sumly_app_password
POSTGRES_MIGRATION_USER=sumly_migration
POSTGRES_MIGRATION_PASSWORD=sumly_migration_password

# Producción: BETTER_AUTH_SECRET distinto y fuerte
# Dev/Test:    BETTER_AUTH_SECRET distinto al de prod
# Local:       cualquier valor para desarrollo
BETTER_AUTH_SECRET=your-secret-key-here

# ── Backend ──────────────────────────────────────────────
# Prod:  https://api.sumly.com
# Dev:   https://dev-api.sumly.com
# Local: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Local: DATABASE_URL apunta a localhost:5433
# Prod/Dev: la construye docker-compose automáticamente
# En local podés usar el usuario admin (postgres) o el app (sumly_app)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sumly_db

# Prod:  production
# Dev:   development
# Local: development
NODE_ENV=development

# Clave de al menos 32 caracteres para AES-256
ENCRYPTION_KEY=una-clave-de-al-menos-32-caracteres-para-aes-256

# ── AWS (compartido por S3 y SES) ───────────────────────
# La region y el email remitente de SES estan hardcodeados en cada
# docker-compose (deben coincidir con la identidad verificada en la
# consola de SES). Aca solo van las credenciales del usuario IAM,
# con permisos sobre S3 (archivos) y SES (ses:SendEmail).
AWS_ACCESS_KEY_ID=tu-access-key-id
AWS_SECRET_ACCESS_KEY=tu-secret-access-key

# Nombre del bucket S3 (distinto por ambiente)
S3_BUCKET=tu-bucket-s3

# ── Frontend ─────────────────────────────────────────────
# Prod:  https://api.sumly.com
# Dev:   https://dev-api.sumly.com
# Local: http://localhost:3000
VITE_API_URL=http://localhost:3000
