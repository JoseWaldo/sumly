# ── Compartidas (todos los ambientes) ────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sumly_db

# Producción: BETTER_AUTH_SECRET distinto y fuerte
# Dev/Test:    BETTER_AUTH_SECRET distinto al de prod
# Local:       cualquier valor para desarrollo
BETTER_AUTH_SECRET=your-secret-key-here

# ── Backend ──────────────────────────────────────────────
# Prod:  https://api.sumly.com
# Dev:   https://dev-api.sumly.com
# Local: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Local: DATABASE_URL apunta a localhost:5433
# Prod/Dev: la construye docker-compose automáticamente
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sumly_db

# Prod:  production
# Dev:   development
# Local: development
NODE_ENV=development

# Clave de al menos 32 caracteres para AES-256
ENCRYPTION_KEY=una-clave-de-al-menos-32-caracteres-para-aes-256

# ── SMTP ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion
SMTP_FROM="Sumly <tu-correo@gmail.com>"

# ── Frontend ─────────────────────────────────────────────
# Prod:  https://api.sumly.com
# Dev:   https://dev-api.sumly.com
# Local: http://localhost:3000
VITE_API_URL=http://localhost:3000
