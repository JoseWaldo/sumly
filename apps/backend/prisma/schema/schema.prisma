generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  files               FileRecord[]
  sessions            Session[]
  accounts            Account[]
  categories          Category[]
  transactions        Transaction[]
  subscriptions       Subscription[]
  subscriptionTags    SubscriptionTag[]
  entidadesFinancieras EntidadFinanciera[]
  formasPago          FormaPago[]
  friendshipsAsRequester Friendship[]   @relation("FriendshipRequester")
  friendshipsAsAddressee Friendship[]   @relation("FriendshipAddressee")
  blockedFriendships  Friendship[]      @relation("FriendshipBlocker")
  deudasGrupos        DeudaGrupo[]
  deudasComoAcreedor  Deuda[]          @relation("DeudaAcreedor")
  deudasComoDeudor    Deuda[]          @relation("DeudaDeudor")
  movimientos         Movimiento[]

  @@map("tbl_user")
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Category {
  id        String       @id @default(cuid())
  name      String
  type      CategoryType
  icon      String       @default("Tag")
  userId    String?      @map("user_id")
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  transactions Transaction[]

  @@unique([name, userId])
  @@map("tbl_category")
}

model Transaction {
  id           String    @id @default(cuid())
  amount       Decimal   @db.Decimal(10, 2)
  date         DateTime  @db.Date
  description  String?   @db.VarChar(255)
  categoryId   String    @map("category_id")
  category     Category  @relation(fields: [categoryId], references: [id])
  formaPagoId  String    @map("forma_pago_id")
  formaPago    FormaPago @relation(fields: [formaPagoId], references: [id], onDelete: Restrict)
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("tbl_transaction")
}

model FileRecord {
  id           String   @id @default(cuid())
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  s3Key        String   @map("s3_key")
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  abonosComprobante DeudaAbono[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("tbl_file")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tbl_session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@map("tbl_account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("tbl_verification")
}

enum SubscriptionFrequency {
  MONTHLY
  YEARLY
  QUARTERLY
  BIWEEKLY
  WEEKLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model SubscriptionTag {
  id            String         @id @default(cuid())
  name          String
  color         String         @default("#6b7280")
  userId        String         @map("user_id")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([name, userId])
  @@map("tbl_subscription_tag")
}

model Subscription {
  id              String               @id @default(cuid())
  name            String
  amount          Decimal              @db.Decimal(10, 2)
  nextPaymentDate DateTime             @map("next_payment_date") @db.Date
  frequency       SubscriptionFrequency @default(MONTHLY)
  status          SubscriptionStatus    @default(ACTIVE)
  userId          String               @map("user_id")
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  formaPagoId     String               @map("forma_pago_id")
  formaPago       FormaPago            @relation(fields: [formaPagoId], references: [id], onDelete: Restrict)
  tags            SubscriptionTag[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@map("tbl_subscription")
}

enum FormaPagoTipo {
  CREDIT
  DEBIT
  CASH
}

model EntidadFinanciera {
  id              String       @id @default(cuid())
  nombre          String
  gradienteInicio String       @map("gradiente_inicio")
  gradienteFin    String       @map("gradiente_fin")
  formatoNumero   String?      @map("formato_numero")
  esSistema       Boolean      @default(false) @map("es_sistema")
  userId          String?      @map("user_id")
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  formasPago      FormaPago[]
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([nombre, userId])
  @@map("tbl_entidad_financiera")
}

model FormaPago {
  id                  String              @id @default(cuid())
  nombre              String
  tipo                FormaPagoTipo
  numeroEncriptado    String?             @map("numero_encriptado")
  ultimosCuatro       String?             @db.VarChar(4) @map("ultimos_cuatro")
  publico             Boolean             @default(false)
  gradienteInicio     String              @map("gradiente_inicio")
  gradienteFin        String              @map("gradiente_fin")
  entidadFinancieraId String?             @map("entidad_financiera_id")
  entidadFinanciera   EntidadFinanciera?  @relation(fields: [entidadFinancieraId], references: [id], onDelete: Restrict)
  userId              String              @map("user_id")
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions       Subscription[]
  transactions        Transaction[]
  abonosDeuda         DeudaAbono[]
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@map("tbl_forma_pago")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum DeudaDireccion {
  ME_DEBEN
  YO_DEBO
}

enum DeudaEstado {
  PENDIENTE
  ESPERANDO_CONFIRMACION
  PAGADA
  DISPUTADA
  VENCIDA
  CANCELADA
  PERDONADA
}

enum DeudaAbonoEstado {
  PENDIENTE_CONFIRMACION
  CONFIRMADO
  RECHAZADO
}

enum MovimientoTipo {
  ENTRADA
  SALIDA
}

enum MovimientoNaturaleza {
  REAL
  NEUTRAL
}

enum MovimientoOrigenTipo {
  MANUAL
  DEUDA
  AHORRO
  SUSCRIPCION
}

model Friendship {
  id             String            @id @default(cuid())
  requesterId    String            @map("requester_id")
  requester      User              @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId    String            @map("addressee_id")
  addressee      User              @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status         FriendshipStatus  @default(PENDING)
  previousStatus FriendshipStatus? @map("previous_status")
  blockedById    String?           @map("blocked_by_id")
  blockedBy      User?             @relation("FriendshipBlocker", fields: [blockedById], references: [id], onDelete: SetNull)
  respondedAt    DateTime?         @map("responded_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@map("tbl_friendship")
}

model DeudaGrupo {
  id              String          @id @default(cuid())
  autorId         String          @map("autor_id")
  autor           User            @relation(fields: [autorId], references: [id], onDelete: Restrict)
  direccion       DeudaDireccion
  descripcion     String
  montoBase       Decimal         @db.Decimal(10, 2) @map("monto_base")
  fechaVencimiento DateTime       @map("fecha_vencimiento") @db.Date
  autoConfirmar   Boolean         @default(true) @map("auto_confirmar")
  deudas          Deuda[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@map("tbl_deuda_grupo")
}

model Deuda {
  id                          String          @id @default(cuid())
  grupoId                     String?         @map("grupo_id")
  grupo                       DeudaGrupo?     @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  acreedorId                  String          @map("acreedor_user_id")
  acreedor                    User            @relation("DeudaAcreedor", fields: [acreedorId], references: [id], onDelete: Restrict)
  deudorId                    String?         @map("deudor_user_id")
  deudor                      User?           @relation("DeudaDeudor", fields: [deudorId], references: [id], onDelete: Restrict)
  deudorNombreLibre           String?         @map("deudor_nombre_libre")
  contraparteSnapshotNombre   String          @map("contraparte_snapshot_nombre")
  contraparteSnapshotAvatar   String?         @map("contraparte_snapshot_avatar")
  espejoDeId                  String?         @unique @map("espejo_de_id")
  espejoDe                    Deuda?          @relation("DeudaEspejo", fields: [espejoDeId], references: [id], onDelete: Restrict)
  espejos                     Deuda[]         @relation("DeudaEspejo")
  monto                       Decimal         @db.Decimal(10, 2)
  saldoPendiente              Decimal         @db.Decimal(10, 2) @map("saldo_pendiente")
  estado                      DeudaEstado     @default(PENDIENTE)
  autoConfirmar               Boolean         @default(true) @map("auto_confirmar")
  abonos                      DeudaAbono[]
  eventos                     DeudaEvento[]
  createdAt                   DateTime        @default(now()) @map("created_at")
  updatedAt                   DateTime        @updatedAt @map("updated_at")

  @@index([acreedorId])
  @@index([deudorId])
  @@map("tbl_deuda")
}

model DeudaAbono {
  id                String              @id @default(cuid())
  deudaId           String              @map("deuda_id")
  deuda             Deuda               @relation(fields: [deudaId], references: [id], onDelete: Restrict)
  monto             Decimal             @db.Decimal(10, 2)
  estado            DeudaAbonoEstado    @default(PENDIENTE_CONFIRMACION)
  formaPagoId       String              @map("forma_pago_id")
  formaPago         FormaPago           @relation(fields: [formaPagoId], references: [id], onDelete: Restrict)
  comprobanteFileId String?             @map("comprobante_file_id")
  comprobanteFile   FileRecord?         @relation(fields: [comprobanteFileId], references: [id], onDelete: SetNull)
  aiReviewStatus    String?             @map("ai_review_status")
  aiReviewNota      String?             @map("ai_review_nota")
  idempotencyKey    String              @unique @map("idempotency_key")
  confirmedAt       DateTime?           @map("confirmed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@map("tbl_deuda_abono")
}

model DeudaEvento {
  id          String   @id @default(cuid())
  deudaId     String   @map("deuda_id")
  deuda       Deuda    @relation(fields: [deudaId], references: [id], onDelete: Cascade)
  tipoEvento  String   @map("tipo_evento")
  actorUserId String?  @map("actor_user_id")
  metadata    Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([deudaId, createdAt])
  @@map("tbl_deuda_evento")
}

model Movimiento {
  id            String                @id @default(cuid())
  userId        String                @map("usuario_id")
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  tipo          MovimientoTipo
  naturaleza    MovimientoNaturaleza
  monto         Decimal               @db.Decimal(10, 2)
  origenTipo    MovimientoOrigenTipo  @map("origen_tipo")
  origenId      String?               @map("origen_id")
  reversaDeId   String?               @unique @map("reversa_de_id")
  reversaDe     Movimiento?           @relation("MovimientoReversa", fields: [reversaDeId], references: [id], onDelete: SetNull)
  reversas      Movimiento[]          @relation("MovimientoReversa")
  editable      Boolean               @default(false)
  createdAt     DateTime              @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([origenTipo, origenId])
  @@map("tbl_movimiento")
}
