# Local: podés usar el admin (postgres) para desarrollo
# Docker: se configura automáticamente con usuario limitado (sumly_app)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sumly_db

# Solo necesario en Docker/VPS para ejecutar migraciones con permisos DDL
# MIGRATION_DATABASE_URL=postgresql://sumly_migration:password@localhost:5432/sumly_db

BETTER_AUTH_SECRET=your-secret-key-here

PORT=3000
NODE_ENV=development

# URL base del frontend, usada para construir los links de los correos transaccionales
FRONTEND_URL=http://localhost:5173

# AWS (credenciales compartidas por S3 y SES — misma cuenta/IAM)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu-access-key-id
AWS_SECRET_ACCESS_KEY=tu-secret-access-key

# S3 (archivos adjuntos, fotos de perfil)
S3_BUCKET=sumly-private-local
# Solo si usás un proveedor S3-compatible distinto de AWS (MinIO, R2, etc.)
# S3_ENDPOINT=

# SES (correos transaccionales). SES_FROM_EMAIL debe estar verificado como
# identidad en la consola de SES (dominio o email individual) antes de poder
# enviar correos con esa direccion como remitente. Mientras la cuenta este en
# modo "sandbox", SES solo permite enviar a direcciones tambien verificadas:
# hay que pedir "production access" desde la consola para enviar a cualquier
# destinatario.
SES_FROM_EMAIL=no-reply@sumly.nytrolabs.net
SES_FROM_NAME=Sumly

ENCRYPTION_KEY=una-clave-de-al-menos-32-caracteres-para-aes-256
